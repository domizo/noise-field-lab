{
  "name": "noise-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive field guide to procedural noise, domain warping, and vector flow.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "test:browser": "node tests/browser-smoke.mjs",
    "docs:figures": "node scripts/generate-doc-figures.mjs && node scripts/localize-doc-figures.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "playwright": "^1.55.1",
    "vite": "^7.1.7"
  }
}
